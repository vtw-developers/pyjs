  (fragment ("js.binary_expression" ("js.identifier" "_val1_") (str "*") ("js.unary_expression" (str "-") ("js.number" (val "1")))) "*1")
)

(match_expand
  (fragment ("py.unary_operator" (str "-") ("py.identifier" "_val_")) "*")
  (fragment ("js.binary_expression" ("js.unary_expression" (str "-") ("js.number" (val "1"))) (str "*") ("js.identifier" "_val1_")) "*1")
)

