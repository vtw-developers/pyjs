  (fragment ("js.call_expression" ("js.parenthesized_expression" (str "(") ("js.arrow_function" (nostr) ("js.formal_parameters" (str "(") (str ")")) (str "=>") ("js.statement_block" (str "{") ("js.lexical_declaration" (str "const") ("js.variable_declarator" ("js.identifier" (val "s")) (str "=") ("js.call_expression" ("js.member_expression" ("js.call_expression" ("js.identifier" (val "String")) ("js.arguments" (str "(") ".1" (str ")"))) (str ".") ("js.property_identifier" (val "trim"))) ("js.arguments" (str "(") (str ")")))) (str ";")) ("js.if_statement" (str "if") ("js.parenthesized_expression" (str "(") ("js.unary_expression" (str "!") ("js.call_expression" ("js.member_expression" ("js.regex" (str "/") ("js.regex_pattern" (val "^[+-]?\\d+$")) (str "/")) (str ".") ("js.property_identifier" (val "test"))) ("js.arguments" (str "(") ("js.identifier" (val "s")) (str ")")))) (str ")")) ("js.statement_block" (str "{") ("js.throw_statement" (str "throw") ("js.new_expression" (str "new") ("js.identifier" (val "Error")) ("js.arguments" (str "(") ("js.string" (str "'") ("js.string_fragment" (val "ValueError")) (str "'")) (str ")"))) (str ";")) (str "}"))) ("js.return_statement" (str "return") ("js.call_expression" ("js.identifier" (val "BigInt")) ("js.arguments" (str "(") ("js.identifier" (val "s")) (str ")"))) (str ";")) (str "}"))) (str ")")) ("js.arguments" (str "(") (str ")"))) "*2")
)

(match_expand
  (fragment ("py.binary_operator" "." (str "/") ".") "*")
  (fragment ("js.binary_expression" ".1" (str "/") ".2") "*3")
)

(match_expand
  (fragment ("py.parenthesized_expression" (str "(") "." (str ")")) "*")
  (fragment ("js.parenthesized_expression" (str "(") ".1" (str ")")) "*2")
)

(match_expand
  (fragment ("py.binary_operator" ("py.identifier" "_val_") (str "-") ".") "*")
  (fragment ("js.binary_expression" ("js.identifier" "_val1_") (str "-") ".1") "*2")
)

(match_expand
  (fragment ("py.module" "*"))
  (fragment ("js.program" "*1"))
)

(match_expand
  (fragment ("py.function_definition" (str "def") "*") "*")
  (fragment ("js.function_declaration" (str "function") "*1") "*2")
)

(match_expand
  (fragment ("py.identifier" "_val_") "*")
  (fragment ("js.identifier" "_val1_") "*1")
)

(match_expand
  (fragment ("py.parameters" "*") "*")
  (fragment ("js.formal_parameters" "*1") "*2")
)

(match_expand
  (fragment ("py.default_parameter" "." (str "=") ".") "*")
  (fragment ("js.assignment_pattern" ".1" (str "=") ".2") "*3")
)

(match_expand
  (fragment ("py.block" "*") "*")
  (fragment ("js.statement_block" "*1") "*2")
)

(match_expand
  (fragment ("py.pass_statement" "*") "*")
  (fragment "*2")
)

(match_expand
  (fragment ("py.integer" "_val_") "*")
  (fragment ("js.number" "_val1_") "*1")
)

(match_expand
  (fragment ("py.float" "_val_") "*")
  (fragment ("js.number" "_val1_") "*1")
)

(match_expand
  (fragment ("py.string_content" "_val_") "*")
  (fragment ("js.string_fragment" "_val1_") "*1")
)

(match_expand
  (fragment ("py.string" "*") "*")
  (fragment ("js.string" "*1") "*2")
)

(match_expand
  (fragment ("py.comment" "_val_") "*")
  (fragment "*1")
)

(match_expand
  (fragment ("py.import_from_statement" (str "from") ("py.dotted_name" ("py.identifier" "_val_")) (str "import") ("py.wildcard_import" (str "*"))) "*")
  (fragment "*1")
)

(match_expand
  (fragment ("py.import_from_statement" (str "from") ("py.dotted_name" ("py.identifier" "_val_")) (str "import") ("py.dotted_name" ("py.identifier" "_val_"))) "*")
  (fragment "*1")
)

(match_expand
  (fragment ("py.import_statement" (str "import") ("py.dotted_name" ("py.identifier" "_val_"))) "*")
  (fragment "*1")
)

;;;; myexactlog with any number of arguments
(match_expand
  (fragment ("py.expression_statement" ("py.call" ("py.identifier" (val "myexactlog")) ("py.argument_list" (str "(") "*" ))) "*")
  (fragment ("js.expression_statement" ("js.call_expression" ("js.identifier" (val "myexactlog")) ("js.arguments" (str "(") "*1" ))) "*2")
)