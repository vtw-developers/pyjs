(match_expand
  (fragment ("py.true" (str "True")) "*")
  (fragment ("js.true" (str "true")) "*1")
)

(match_expand
  (fragment ("py.true" (str "True")) "*")
  (fragment ("js.unary_expression" (str "!") ("js.number" (val "0"))) "*1")
)

(match_expand
  (fragment ("py.true" (str "True")) "*")
  (fragment ("js.unary_expression" (str "!") ("js.unary_expression" (str "!") ("js.number" (val "1")))) "*1")
)

(match_expand
  (fragment ("py.true" (str "True")) "*")
  (fragment ("js.unary_expression" (str "!") ("js.false" (str "false"))) "*1")
)

(match_expand
  (fragment ("py.true" (str "True")) "*")
  (fragment ("js.call_expression" ("js.identifier" (val "Boolean")) ("js.arguments" (str "(") ("js.true" (str "true")) (str ")"))) "*1")
)

