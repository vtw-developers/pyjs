(match_expand
  (fragment ("py.comparison_operator" ("py.identifier" "_val_") (str "==") ".") "*")
  (fragment ("js.binary_expression" ("js.identifier" "_val1_") (str "===") ".1") "*2")
)

(match_expand
  (fragment ("py.return_statement" (str "return") ".") "*")
  (fragment ("js.return_statement" (str "return") ".1" (str ";")) "*2")
)

(match_expand
  (fragment ("py.call" ("py.identifier" (val "f_gold")) ("py.argument_list" (str "(") "." (str ")"))) "*")
  (fragment ("js.call_expression" ("js.identifier" (val "f_gold")) ("js.arguments" (str "(") ".1" (str ")"))) "*2")
)

(match_expand
  (fragment ("py.unary_operator" (str "-") ("py.identifier" "_val_")) "*")
  (fragment ("js.unary_expression" (str "-") ("js.identifier" "_val1_")) "*1")
)

(match_expand
  (fragment ("py.unary_operator" (str "-") ("py.identifier" "_val_")) "*")
  (fragment ("js.unary_expression" (str "-") ("js.parenthesized_expression" (str "(") ("js.identifier" "_val1_") (str ")"))) "*1")
)

(match_expand
  (fragment ("py.unary_operator" (str "-") ("py.identifier" "_val_")) "*")
  (fragment ("js.binary_expression" ("js.number" (val "0")) (str "-") ("js.identifier" "_val1_")) "*1")
)

