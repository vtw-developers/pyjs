  (fragment ("js.binary_expression" ("js.number" (val "0n")) (str "-") ("js.identifier" "_val1_")) "*1")
)

(match_expand
  (fragment ("py.unary_operator" (str "-") ("py.identifier" "_val_")) "*")
  (fragment ("js.binary_expression" ("js.identifier" "_val1_") (str "*") ("js.unary_expression" (str "-") ("js.number" (val "1n")))) "*1")
)

(match_expand
